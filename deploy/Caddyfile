# tinylnk -- Caddy reverse-proxy configuration
#
# Replace {$DOMAIN} with your actual domain (e.g. example.com).
# Caddy will automatically provision and renew Let's Encrypt TLS
# certificates for this domain.
#
# For local / non-DNS development, uncomment the "localhost" block
# below and comment out the {$DOMAIN} block.

{
    # Disable the admin API in production
    admin off
}

# ---------------------------------------------------------------------------
# Production block -- requires a real DNS A/AAAA record pointing at your
# server's public IP.  Caddy handles ACME HTTP-01 challenges automatically
# on port 80, then serves HTTPS on port 443.
# ---------------------------------------------------------------------------
{$DOMAIN:example.com} {
    reverse_proxy app:8000

    # ---- Security headers ----
    header {
        # HTTP Strict Transport Security -- 1 year, include subdomains, preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Restrict referrer information
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict browser features
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    }

    # ---- Structured JSON access logs ----
    log {
        output file /data/logs/access.log {
            roll_size 100 MiB
            roll_keep 5
        }
        format json
    }

    # ---- Health check ----
    # Proxied so the app's own /api/health handler is the single source of
    # truth for both Docker HEALTHCHECK and load-balancer probes.
    handle /api/health {
        reverse_proxy app:8000
    }

    # ---- Compress responses ----
    encode gzip
}

# ---------------------------------------------------------------------------
# Local development block (uncomment and comment the block above to use)
# ---------------------------------------------------------------------------
# http://localhost:8080 {
#     reverse_proxy app:8000
#
#     log {
#         output file /data/logs/access.log {
#             roll_size 10 MiB
#             roll_keep 3
#         }
#         format json
#     }
#
#     handle /health {
#         reverse_proxy app:8000
#     }
# }
