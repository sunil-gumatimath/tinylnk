# tinylnk configuration
# PostgreSQL (Neon) connection URL — required. SQLite is not a supported runtime
# database; it backs the unit-test suite only (see the README's testing notes).
# Prefer Neon's pooled URL and keep sslmode=require.
# Example: postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
TINYLNK_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Set to "true" to show a warning page before redirecting users
TINYLNK_REDIRECT_WARNING=false

# Set to "true" to expose the Swagger /docs and /openapi.json endpoints (off by default)
TINYLNK_ENABLE_DOCS=false

# Resolve hostnames at shorten time and reject any that point at private /
# link-local ranges (blocks "public domain that resolves to 169.254.169.254").
# Adds a DNS lookup per shortened URL; off by default.
TINYLNK_DNS_CHECK=false

# --- Per-user ownership -------------------------------------------------------
# Links created while signed in belong to that Clerk user: only they (and the
# admins below) can view analytics, edit, or delete them. Links created while
# signed out are ownerless and manageable by admins only.
#
# Comma-separated Clerk user ids (the JWT "sub" claim). Admins can manage every
# link, including ownerless legacy rows created before schema v2.
TINYLNK_ADMIN_USER_IDS=

# --- Rate limits (per client IP) ---------------------------------------------
# SlowAPI limit strings ("100/minute", "5/second", ...). Redirect and QR limits
# are high on purpose: a single shared link or printed QR code can put many
# visitors behind one NAT / corporate egress IP.
TINYLNK_RATE_LIMIT_SHORTEN=30/minute
TINYLNK_RATE_LIMIT_UPDATE=30/minute
TINYLNK_RATE_LIMIT_STATS=60/minute
TINYLNK_RATE_LIMIT_EXPORT=30/minute
TINYLNK_RATE_LIMIT_RECENT=60/minute
TINYLNK_RATE_LIMIT_TAGS=60/minute
TINYLNK_RATE_LIMIT_DELETE=20/minute
TINYLNK_RATE_LIMIT_REDIRECT=600/minute
TINYLNK_RATE_LIMIT_QR=120/minute

# Logging level: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: "text" for human-readable (default), "json" for production / log aggregators
LOG_FORMAT=text

# Optional: Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# --- Clerk authentication (optional) -----------------------------------------
# Leave all three blank to run without sign-in: shortening and redirects still
# work, but the management endpoints (edit/delete/stats/recent/tags/export)
# return 401 for everyone.

# Publishable key for the BROWSER. Vite inlines VITE_* variables at build time,
# so the frontend must be rebuilt after changing this (docker compose up -d --build).
VITE_CLERK_PUBLISHABLE_KEY=

# Expected `iss` claim of incoming JWTs. The backend fetches signing keys from
# <CLERK_ISSUER>/.well-known/jwks.json — no secret key is needed.
CLERK_ISSUER=

# Optional backend fallback: when CLERK_ISSUER is unset, the issuer is derived
# from this publishable key instead.
# CLERK_PUBLISHABLE_KEY=
